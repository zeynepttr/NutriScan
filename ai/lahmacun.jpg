    color: #212121; /*wprm_header_text type=color*/
    line-height: 1.3em; /*wprm_header_line_height type=font_size*/
}
.wprm-recipe-template-ayla_chic h1,
.wprm-recipe-template-ayla_chic h2,
.wprm-recipe-template-ayla_chic h3,
.wprm-recipe-template-ayla_chic h4,
